# .env.example — مُولَّدٌ من السجلِّ المرجعيِّ. لا يُحرَّرُ بيدٍ.
# المصدرُ: packages/config/env-registry.json
# التوليدُ: python3 scripts/config/render-config-artifacts.py
# المرجعُ: docs/08-infrastructure/CONFIG_SCHEMA.md
#
# لا تُكتَبُ قيمةُ سرٍّ هنا: كلُّ سرٍّ قيمتُهُ __SET_ME__.

# ────────────────────────────────────────────────────────────────────
# متغيّراتُ التشغيلِ الإنتاجيِّ (85 متغيّراً)
# ────────────────────────────────────────────────────────────────────

# PostgreSQL connection string for billing service (M5-17). Format: postgresql://USER:PASSWORD@HOST:5432/DB
# النوعُ: وصلةُ Postgres · الإلزامُ: optional · الافتراضيُّ: لا افتراضيَّ · القارئون: 3 · البندُ: M5-17
# ملاحظةٌ: غيابُها ليسَ إخفاقاً بقصدٍ: الخدمةُ تُقلِعُ بمخازنِ الذاكرةِ وتُعلِنُ `persistence: memory` في صحّتِها.
BILLING_DATABASE_URL=__SET_ME__

# اتصالٌ للقراءةِ فقط بقاعدةٍ تحوي `delivery_outbox` — مصدرُ أحداثِ `store_order.*` لمُرحِّلِ الفوترة (M5-17Q · يحلُّ محلَّ `BILLING_ORDER_EVENTS_DATABASE_URL`). Format: postgresql://USER:PASSWORD@HOST:5432/DB
# النوعُ: وصلةُ Postgres · الإلزامُ: optional · الافتراضيُّ: لا افتراضيَّ · القارئون: 1 · البندُ: M5-17Q
# ملاحظةٌ: غيابُها ليسَ إخفاقاً: الخادمُ يُقلِعُ بلا حلقةِ مُرحِّلٍ ويُعلِنُ ذلكَ في السجلّ. وحضورُها بلا `BILLING_DATABASE_URL` لا يُشغِّلُ المُرحِّلَ (لا مُرحِّلَ على مخازنِ الذاكرة).
BILLING_DELIVERY_EVENTS_DATABASE_URL=__SET_ME__

# مُعرِّفاتُ مجموعاتِ المجتمعِ.
# النوعُ: قائمةٌ بفواصلَ · الإلزامُ: optional · الافتراضيُّ: لا افتراضيَّ · القارئون: 1 · البندُ: M2-04
COMMUNITY_GROUP_CHAT_IDS=

# قالبُ الرابطِ العميقِ لبوتِ العميلِ.
# النوعُ: نصٌّ · الإلزامُ: optional · الافتراضيُّ: لا افتراضيَّ · القارئون: 1 · البندُ: M2-04
# ملاحظةٌ: الاسمُ مُشتَقٌّ في `envNames(bot)` من بادئةِ البوتِ — لا يُقرأُ حرفاً في الشيفرةِ، فنمطُهُ `template` والبابُ 2 يحرسُ حضورَ القالبِ.
CUSTOMER_BOT_DEEP_LINK_TEMPLATE=

# نصُّ زرِّ التطبيقِ المُصغَّرِ لبوتِ العميلِ.
# النوعُ: نصٌّ · الإلزامُ: optional · الافتراضيُّ: لا افتراضيَّ · القارئون: 1 · البندُ: M2-04
# ملاحظةٌ: الاسمُ مُشتَقٌّ في `envNames(bot)` من بادئةِ البوتِ — لا يُقرأُ حرفاً في الشيفرةِ، فنمطُهُ `template` والبابُ 2 يحرسُ حضورَ القالبِ.
CUSTOMER_BOT_MINI_APP_LABEL=

# عنوانُ التطبيقِ المُصغَّرِ لبوتِ العميلِ — https إلزاماً.
# النوعُ: عنوانُ HTTP · الإلزامُ: always · الافتراضيُّ: لا افتراضيَّ · القارئون: 1 · البندُ: M2-04
# ملاحظةٌ: الاسمُ مُشتَقٌّ في `envNames(bot)` من بادئةِ البوتِ — لا يُقرأُ حرفاً في الشيفرةِ، فنمطُهُ `template` والبابُ 2 يحرسُ حضورَ القالبِ.
CUSTOMER_BOT_MINI_APP_URL=

# منفذُ استماعِ بوتِ العميلِ.
# النوعُ: منفذٌ (1..65535) · الإلزامُ: optional · الافتراضيُّ: 8083 · القارئون: 1 · البندُ: M2-04
# ملاحظةٌ: الاسمُ مُشتَقٌّ في `envNames(bot)` من بادئةِ البوتِ — لا يُقرأُ حرفاً في الشيفرةِ، فنمطُهُ `template` والبابُ 2 يحرسُ حضورَ القالبِ.
CUSTOMER_BOT_PORT=8083

# رمزُ بوتِ العميلِ من Telegram — لا يُسجَّلُ ولا يُلتزَمُ.
# النوعُ: مادّةٌ سرِّيّةٌ · الإلزامُ: always · الافتراضيُّ: لا افتراضيَّ · القارئون: 2 · البندُ: M2-04
# ملاحظةٌ: الاسمُ مُشتَقٌّ في `envNames(bot)` من بادئةِ البوتِ — لا يُقرأُ حرفاً في الشيفرةِ، فنمطُهُ `template` والبابُ 2 يحرسُ حضورَ القالبِ.
CUSTOMER_BOT_TOKEN=__SET_ME__

# سرُّ ترويسةِ خطّافِ بوتِ العميلِ (16 محرفاً على الأقلِّ).
# النوعُ: مادّةٌ سرِّيّةٌ · الإلزامُ: always · الافتراضيُّ: لا افتراضيَّ · القارئون: 1 · البندُ: M2-04
# ملاحظةٌ: الاسمُ مُشتَقٌّ في `envNames(bot)` من بادئةِ البوتِ — لا يُقرأُ حرفاً في الشيفرةِ، فنمطُهُ `template` والبابُ 2 يحرسُ حضورَ القالبِ.
CUSTOMER_BOT_WEBHOOK_SECRET=__SET_ME__

# وصلةُ Postgres لجداولِ بوتِ العميلِ وحزمةِ تكاملِهِ.
# النوعُ: وصلةُ Postgres · الإلزامُ: conditional · الافتراضيُّ: لا افتراضيَّ · القارئون: 2 · البندُ: M2-04
CUSTOMER_DATABASE_URL=__SET_ME__

# وصلةُ Postgres للخدمةِ الجاريةِ — كلُّ خدمةٍ تقرأُ الاسمَ نفسَهُ في نشرتِها.
# النوعُ: وصلةُ Postgres · الإلزامُ: conditional · الافتراضيُّ: لا افتراضيَّ · القارئون: 101 · البندُ: M2-04
# ملاحظةٌ: غيابُها ليسَ إخفاقاً بقصدٍ: الخدمةُ تُقلِعُ بمخازنِ الذاكرةِ وتُعلِنُ `persistence: memory` في صحّتِها. الصيغةُ: postgresql://USER:PASSWORD@HOST:5432/DB
DATABASE_URL=__SET_ME__

# مهلةُ التصعيدِ الكلّيّةُ للمهمّةِ بالثواني.
# النوعُ: عددٌ صحيحٌ ≥ 1 · الإلزامُ: optional · الافتراضيُّ: 120 · القارئون: 1 · البندُ: M2-04
DISPATCH_ESCALATION_TIMEOUT_SECONDS=120

# أقصى عددِ موجاتٍ قبلَ التصعيدِ.
# النوعُ: عددٌ صحيحٌ ≥ 1 · الإلزامُ: optional · الافتراضيُّ: 3 · القارئون: 1 · البندُ: M2-04
DISPATCH_MAX_WAVES=3

# مهلةُ ردِّ الكابتنِ على العرضِ الواحدِ بالثواني.
# النوعُ: عددٌ صحيحٌ ≥ 1 · الإلزامُ: optional · الافتراضيُّ: 30 · القارئون: 1 · البندُ: M2-04
DISPATCH_OFFER_TIMEOUT_SECONDS=30

# مهلةُ نداءِ خدمةِ التوزيعِ من العملاءِ بالمللي ثانية (D-03 · M5-13D).
# النوعُ: عددٌ صحيحٌ ≥ 1 · الإلزامُ: optional · الافتراضيُّ: لا افتراضيَّ · القارئون: 1 · البندُ: M2-04
# ملاحظةٌ: قيمةٌ غيرُ مقروءةٍ تسقطُ إلى مهلةِ المنفذِ الافتراضيّةِ (2ث) بقرارٍ مكتوبٍ — لا تُوقِفُ الإقلاعَ على حقلٍ ثانويٍّ.
DISPATCH_SERVICE_TIMEOUT_MS=

# عنوانُ خدمةِ التوزيعِ كما تُناديها خدمةُ العملاءِ (D-03 · M5-13D) والمفاوضات.
# النوعُ: عنوانُ HTTP · الإلزامُ: optional · الافتراضيُّ: لا افتراضيَّ · القارئون: 2 · البندُ: M2-04
DISPATCH_SERVICE_URL=

# عددُ الكباتنِ في موجةِ العرضِ الواحدةِ.
# النوعُ: عددٌ صحيحٌ ≥ 1 · الإلزامُ: optional · الافتراضيُّ: 2 · القارئون: 1 · البندُ: M2-04
# ملاحظةٌ: قيمةٌ غيرُ رقميّةٍ كانت تُنتِجُ `NaN` صامتاً قبلَ M2-04 (`RISK-0046`) — الآنَ تُسقِطُ الإقلاعَ باسمِ المتغيّرِ.
DISPATCH_WAVE_SIZE=2

# قالبُ الرابطِ العميقِ لبوتِ الكابتنِ.
# النوعُ: نصٌّ · الإلزامُ: optional · الافتراضيُّ: لا افتراضيَّ · القارئون: 1 · البندُ: M2-04
# ملاحظةٌ: الاسمُ مُشتَقٌّ في `envNames(bot)` من بادئةِ البوتِ — لا يُقرأُ حرفاً في الشيفرةِ، فنمطُهُ `template` والبابُ 2 يحرسُ حضورَ القالبِ.
DRIVER_BOT_DEEP_LINK_TEMPLATE=

# نصُّ زرِّ التطبيقِ المُصغَّرِ لبوتِ الكابتنِ.
# النوعُ: نصٌّ · الإلزامُ: optional · الافتراضيُّ: لا افتراضيَّ · القارئون: 1 · البندُ: M2-04
# ملاحظةٌ: الاسمُ مُشتَقٌّ في `envNames(bot)` من بادئةِ البوتِ — لا يُقرأُ حرفاً في الشيفرةِ، فنمطُهُ `template` والبابُ 2 يحرسُ حضورَ القالبِ.
DRIVER_BOT_MINI_APP_LABEL=

# عنوانُ التطبيقِ المُصغَّرِ لبوتِ الكابتنِ — https إلزاماً.
# النوعُ: عنوانُ HTTP · الإلزامُ: always · الافتراضيُّ: لا افتراضيَّ · القارئون: 1 · البندُ: M2-04
# ملاحظةٌ: الاسمُ مُشتَقٌّ في `envNames(bot)` من بادئةِ البوتِ — لا يُقرأُ حرفاً في الشيفرةِ، فنمطُهُ `template` والبابُ 2 يحرسُ حضورَ القالبِ.
DRIVER_BOT_MINI_APP_URL=

# منفذُ استماعِ بوتِ الكابتنِ.
# النوعُ: منفذٌ (1..65535) · الإلزامُ: optional · الافتراضيُّ: 8084 · القارئون: 1 · البندُ: M2-04
# ملاحظةٌ: الاسمُ مُشتَقٌّ في `envNames(bot)` من بادئةِ البوتِ — لا يُقرأُ حرفاً في الشيفرةِ، فنمطُهُ `template` والبابُ 2 يحرسُ حضورَ القالبِ.
DRIVER_BOT_PORT=8084

# رمزُ بوتِ الكابتنِ من Telegram — لا يُسجَّلُ ولا يُلتزَمُ.
# النوعُ: مادّةٌ سرِّيّةٌ · الإلزامُ: always · الافتراضيُّ: لا افتراضيَّ · القارئون: 2 · البندُ: M2-04
# ملاحظةٌ: الاسمُ مُشتَقٌّ في `envNames(bot)` من بادئةِ البوتِ — لا يُقرأُ حرفاً في الشيفرةِ، فنمطُهُ `template` والبابُ 2 يحرسُ حضورَ القالبِ.
DRIVER_BOT_TOKEN=__SET_ME__

# سرُّ ترويسةِ خطّافِ بوتِ الكابتنِ (16 محرفاً على الأقلِّ).
# النوعُ: مادّةٌ سرِّيّةٌ · الإلزامُ: always · الافتراضيُّ: لا افتراضيَّ · القارئون: 1 · البندُ: M2-04
# ملاحظةٌ: الاسمُ مُشتَقٌّ في `envNames(bot)` من بادئةِ البوتِ — لا يُقرأُ حرفاً في الشيفرةِ، فنمطُهُ `template` والبابُ 2 يحرسُ حضورَ القالبِ.
DRIVER_BOT_WEBHOOK_SECRET=__SET_ME__

# وصلةُ Postgres لجداولِ بوتِ الكابتنِ وحزمةِ تكاملِهِ.
# النوعُ: وصلةُ Postgres · الإلزامُ: conditional · الافتراضيُّ: لا افتراضيَّ · القارئون: 2 · البندُ: M2-04
DRIVER_DATABASE_URL=__SET_ME__

# مناطقُ تطويرٍ تُمنَحُ للكابتنِ بلا تحقُّقٍ جغرافيٍّ — للتطويرِ المحلّيِّ وحدَهُ.
# النوعُ: قائمةٌ بفواصلَ · الإلزامُ: optional · الافتراضيُّ: لا افتراضيَّ · القارئون: 1 · البندُ: M2-04
# ملاحظةٌ: حضورُها في نشرةِ إنتاجٍ خطرٌ مُعلَنٌ: تُقرأُ في `outbound-wiring` بلا سلطةٍ جغرافيّةٍ.
DRIVER_DEV_ZONE_IDS=

# مُعرِّفاتُ مجموعاتِ التصعيدِ.
# النوعُ: قائمةٌ بفواصلَ · الإلزامُ: optional · الافتراضيُّ: لا افتراضيَّ · القارئون: 1 · البندُ: M2-04
ESCALATION_GROUP_CHAT_IDS=

# عنوانُ خدمةِ الجغرافيا كما تُناديها المطابقةُ.
# النوعُ: عنوانُ HTTP · الإلزامُ: optional · الافتراضيُّ: http://localhost:8081 · القارئون: 1 · البندُ: M2-04
GEOGRAPHY_BASE_URL=http://localhost:8081

# عنوانُ خدمةِ الجغرافيا كما يُناديها العملاءُ والكباتنُ وبوتُ العميلِ.
# النوعُ: عنوانُ HTTP · الإلزامُ: optional · الافتراضيُّ: لا افتراضيَّ · القارئون: 3 · البندُ: M2-04
# ملاحظةٌ: غيابُهُ يُنتِجُ منفذاً مُعلَنَ العطبِ لا سقوطاً صامتاً.
GEOGRAPHY_SERVICE_URL=

# عمرُ مفتاحِ عدمِ التكرارِ بالثواني قبلَ استحقاقِ الكنسِ.
# النوعُ: عددٌ صحيحٌ ≥ 1 · الإلزامُ: optional · الافتراضيُّ: 86400 · القارئون: 1 · البندُ: M2-04
# ملاحظةٌ: لهُ أرضيّةٌ في الشيفرةِ: أقلُّ من 3600 ثانيةً مرفوضٌ.
IDEMPOTENCY_KEY_TTL_SECONDS=86400

# حجمُ دُفعةِ كنسِ مفاتيحِ عدمِ التكرارِ.
# النوعُ: عددٌ صحيحٌ ≥ 1 · الإلزامُ: optional · الافتراضيُّ: 500 · القارئون: 1 · البندُ: M2-04
IDEMPOTENCY_SWEEP_BATCH_SIZE=500

# أقصى عددِ دُفعاتٍ في جولةِ كنسٍ واحدةٍ.
# النوعُ: عددٌ صحيحٌ ≥ 1 · الإلزامُ: optional · الافتراضيُّ: 20 · القارئون: 1 · البندُ: M2-04
IDEMPOTENCY_SWEEP_MAX_BATCHES=20

# عنوانُ خدمةِ الهويّةِ لتهيئةِ الجلساتِ.
# النوعُ: عنوانُ HTTP · الإلزامُ: optional · الافتراضيُّ: لا افتراضيَّ · القارئون: 6 · البندُ: M2-04
# ملاحظةٌ: غيابُهُ يعني «لا تهيئةَ هويّةٍ موصولةٌ»؛ وحضورُهُ بلا `WASLA_SERVICE_AUTH_KEYS` إخفاقٌ عندَ الإقلاعِ بقصدٍ.
IDENTITY_SERVICE_URL=

# مهلةُ نداءِ خدمةِ الهويّةِ من زمنِ تشغيلِ البوتاتِ بالمللي ثانية.
# النوعُ: عددٌ صحيحٌ ≥ 1 · الإلزامُ: optional · الافتراضيُّ: لا افتراضيَّ · القارئون: 1 · البندُ: M2-04
IDENTITY_TIMEOUT_MS=

# مهلةُ مسبارِ السوقِ بالمللي ثانية — لا تُقبَلُ صفراً: مسبارٌ بمهلةِ صفرٍ لا يسبرُ.
# النوعُ: عددٌ صحيحٌ ≥ 1 · الإلزامُ: optional · الافتراضيُّ: 1000 · القارئون: 1 · البندُ: M2-04
MARKETPLACE_PROBE_TIMEOUT_MS=1000

# صلاحيّةُ نتيجةِ مسبارِ السوقِ بالمللي ثانية (0 يعني «لا تخزينَ»).
# النوعُ: عددٌ صحيحٌ ≥ 0 · الإلزامُ: optional · الافتراضيُّ: 15000 · القارئون: 1 · البندُ: M2-04
MARKETPLACE_PROBE_TTL_MS=15000

# عنوانُ ربطِ خدمةِ السوقِ.
# النوعُ: نصٌّ · الإلزامُ: optional · الافتراضيُّ: 0.0.0.0 · القارئون: 1 · البندُ: M2-04
MARKETPLACE_SERVICE_HOST=0.0.0.0

# منفذُ استماعِ خدمةِ السوقِ — من حزمةِ العقدِ لا من رقمٍ مكتوبٍ في الجذرِ.
# النوعُ: منفذٌ (1..65535) · الإلزامُ: optional · الافتراضيُّ: 8094 · القارئون: 1 · البندُ: M2-04
MARKETPLACE_SERVICE_PORT=8094

# عنوانُ خدمةِ السوقِ كما يُناديها التوصيلُ.
# النوعُ: عنوانُ HTTP · الإلزامُ: optional · الافتراضيُّ: لا افتراضيَّ · القارئون: 1 · البندُ: M2-04
MARKETPLACE_SERVICE_URL=

# مهلةُ نداءِ السوقِ من التوصيلِ بالمللي ثانية.
# النوعُ: عددٌ صحيحٌ ≥ 1 · الإلزامُ: optional · الافتراضيُّ: لا افتراضيَّ · القارئون: 1 · البندُ: M2-04
# ملاحظةٌ: قيمةٌ غيرُ مقروءةٍ تسقطُ إلى الافتراضِ بقرارٍ مكتوبٍ في الجذرِ (ADR-020).
MARKETPLACE_TIMEOUT_MS=

# عنوانُ خدمةِ المطابقةِ كما يُناديها الإرسالُ.
# النوعُ: عنوانُ HTTP · الإلزامُ: optional · الافتراضيُّ: http://localhost:8093 · القارئون: 1 · البندُ: M2-04
MATCHING_BASE_URL=http://localhost:8093

# عنوانُ خدمةِ المطابقةِ كما يُناديها الكباتنُ.
# النوعُ: عنوانُ HTTP · الإلزامُ: optional · الافتراضيُّ: لا افتراضيَّ · القارئون: 1 · البندُ: M2-04
MATCHING_SERVICE_URL=

# عنوانُ خدمةِ المفاوضاتِ كما يُناديها بوتا العميلِ والكابتنِ.
# النوعُ: عنوانُ HTTP · الإلزامُ: optional · الافتراضيُّ: لا افتراضيَّ · القارئون: 2 · البندُ: M2-04
NEGOTIATIONS_SERVICE_URL=

# بيئةُ التشغيلِ. تُقرأُ لغرضٍ واحدٍ: رفضُ نمطِ الذاكرةِ لمخزنِ آثارِ الرموزِ في `production`.
# النوعُ: نصٌّ · الإلزامُ: optional · الافتراضيُّ: لا افتراضيَّ · القارئون: 1 · البندُ: M1-03
# ملاحظةٌ: لا يُشتَقُّ منها سلوكٌ آخرُ في هذا المستودعِ: قيمتُها لا تُبدِّلُ مخازنَ ولا تُخفِّفُ فرضاً، وإنّما تمنعُ اختياراً خطراً طُلِبَ صراحةً (ADR-035 · RISK-0015).
NODE_ENV=

# عنوانُ محرِّكِ الطلباتِ كما يُناديهِ الإرسالُ.
# النوعُ: عنوانُ HTTP · الإلزامُ: optional · الافتراضيُّ: http://localhost:8087 · القارئون: 1 · البندُ: M2-04
ORDERS_BASE_URL=http://localhost:8087

# عنوانُ محرِّكِ الطلباتِ كما تُناديهِ المفاوضاتُ.
# النوعُ: عنوانُ HTTP · الإلزامُ: optional · الافتراضيُّ: لا افتراضيَّ · القارئون: 1 · البندُ: M2-04
ORDERS_SERVICE_URL=

# مهلةُ نداءِ محرِّكِ الطلباتِ من العملاءِ بالمللي ثانية.
# النوعُ: عددٌ صحيحٌ ≥ 1 · الإلزامُ: optional · الافتراضيُّ: لا افتراضيَّ · القارئون: 1 · البندُ: M2-04
# ملاحظةٌ: قيمةٌ غيرُ مقروءةٍ تسقطُ إلى مهلةِ المنفذِ الافتراضيّةِ بقرارٍ مكتوبٍ في الجذرِ — لا تُوقِفُ الإقلاعَ على حقلٍ ثانويٍّ.
ORDER_SERVICE_TIMEOUT_MS=

# عنوانُ محرِّكِ الطلباتِ كما يُناديهِ العملاءُ.
# النوعُ: عنوانُ HTTP · الإلزامُ: optional · الافتراضيُّ: لا افتراضيَّ · القارئون: 1 · البندُ: M2-04
ORDER_SERVICE_URL=

# نقطةُ نهايةِ مُصدِّرِ OpenTelemetry OTLP لتتبُّعِ الطلباتِ. إن لم يُضبَطْ، فالتتبُّعُ عمليةٌ عديمةُ الأثرِ.
# النوعُ: نصٌّ · الإلزامُ: optional · الافتراضيُّ: لا افتراضيَّ · القارئون: 1 · البندُ: M2-08
OTEL_EXPORTER_OTLP_ENDPOINT=

# سلسلةُ اتصالِ PostgreSQL لخدمةِ الشركاءِ (إلزاميّةٌ عند تشغيل الخدمة)
# النوعُ: وصلةُ Postgres · الإلزامُ: conditional · الافتراضيُّ: لا افتراضيَّ · القارئون: 2 · البندُ: M5-14
PARTNERS_DATABASE_URL=__SET_ME__

# مضيفُ خدمةِ الشركاءِ.
# النوعُ: نصٌّ · الإلزامُ: optional · الافتراضيُّ: 0.0.0.0 · القارئون: 1 · البندُ: M5-14
PARTNERS_SERVICE_HOST=0.0.0.0

# منفذُ خدمةِ الشركاءِ في بيئةِ الإنتاج.
# النوعُ: منفذٌ (1..65535) · الإلزامُ: optional · الافتراضيُّ: 8098 · القارئون: 1 · البندُ: M5-14
PARTNERS_SERVICE_PORT=8098

# قالبُ الرابطِ العميقِ لبوتِ الشريكِ.
# النوعُ: نصٌّ · الإلزامُ: optional · الافتراضيُّ: لا افتراضيَّ · القارئون: 1 · البندُ: M2-04
# ملاحظةٌ: الاسمُ مُشتَقٌّ في `envNames(bot)` من بادئةِ البوتِ — لا يُقرأُ حرفاً في الشيفرةِ، فنمطُهُ `template` والبابُ 2 يحرسُ حضورَ القالبِ.
PARTNER_BOT_DEEP_LINK_TEMPLATE=

# نصُّ زرِّ التطبيقِ المُصغَّرِ لبوتِ الشريكِ.
# النوعُ: نصٌّ · الإلزامُ: optional · الافتراضيُّ: لا افتراضيَّ · القارئون: 1 · البندُ: M2-04
# ملاحظةٌ: الاسمُ مُشتَقٌّ في `envNames(bot)` من بادئةِ البوتِ — لا يُقرأُ حرفاً في الشيفرةِ، فنمطُهُ `template` والبابُ 2 يحرسُ حضورَ القالبِ.
PARTNER_BOT_MINI_APP_LABEL=

# عنوانُ التطبيقِ المُصغَّرِ لبوتِ الشريكِ — https إلزاماً.
# النوعُ: عنوانُ HTTP · الإلزامُ: always · الافتراضيُّ: لا افتراضيَّ · القارئون: 1 · البندُ: M2-04
# ملاحظةٌ: الاسمُ مُشتَقٌّ في `envNames(bot)` من بادئةِ البوتِ — لا يُقرأُ حرفاً في الشيفرةِ، فنمطُهُ `template` والبابُ 2 يحرسُ حضورَ القالبِ.
PARTNER_BOT_MINI_APP_URL=

# منفذُ استماعِ بوتِ الشريكِ.
# النوعُ: منفذٌ (1..65535) · الإلزامُ: optional · الافتراضيُّ: 8085 · القارئون: 1 · البندُ: M2-04
# ملاحظةٌ: الاسمُ مُشتَقٌّ في `envNames(bot)` من بادئةِ البوتِ — لا يُقرأُ حرفاً في الشيفرةِ، فنمطُهُ `template` والبابُ 2 يحرسُ حضورَ القالبِ.
PARTNER_BOT_PORT=8085

# رمزُ بوتِ الشريكِ من Telegram — لا يُسجَّلُ ولا يُلتزَمُ.
# النوعُ: مادّةٌ سرِّيّةٌ · الإلزامُ: always · الافتراضيُّ: لا افتراضيَّ · القارئون: 1 · البندُ: M2-04
# ملاحظةٌ: الاسمُ مُشتَقٌّ في `envNames(bot)` من بادئةِ البوتِ — لا يُقرأُ حرفاً في الشيفرةِ، فنمطُهُ `template` والبابُ 2 يحرسُ حضورَ القالبِ.
PARTNER_BOT_TOKEN=__SET_ME__

# سرُّ ترويسةِ خطّافِ بوتِ الشريكِ (16 محرفاً على الأقلِّ).
# النوعُ: مادّةٌ سرِّيّةٌ · الإلزامُ: always · الافتراضيُّ: لا افتراضيَّ · القارئون: 1 · البندُ: M2-04
# ملاحظةٌ: الاسمُ مُشتَقٌّ في `envNames(bot)` من بادئةِ البوتِ — لا يُقرأُ حرفاً في الشيفرةِ، فنمطُهُ `template` والبابُ 2 يحرسُ حضورَ القالبِ.
PARTNER_BOT_WEBHOOK_SECRET=__SET_ME__

# منفذُ الاستماعِ للخدمةِ الجاريةِ.
# النوعُ: منفذٌ (1..65535) · الإلزامُ: optional · الافتراضيُّ: لا افتراضيَّ · القارئون: 19 · البندُ: M2-04
# ملاحظةٌ: لا افتراضيَّ واحدٌ لهُ: كلُّ خدمةٍ تسقطُ إلى منفذِ عقدِها (`*_SERVICE_PORT`) عندَ غيابِهِ.
PORT=

# عنوانُ ربطِ خدمةِ الاشتراكاتِ.
# النوعُ: نصٌّ · الإلزامُ: optional · الافتراضيُّ: 0.0.0.0 · القارئون: 1 · البندُ: M2-04
SUBSCRIPTION_SERVICE_HOST=0.0.0.0

# منفذُ استماعِ خدمةِ الاشتراكاتِ.
# النوعُ: منفذٌ (1..65535) · الإلزامُ: optional · الافتراضيُّ: 8095 · القارئون: 1 · البندُ: M2-04
SUBSCRIPTION_SERVICE_PORT=8095

# مُعرِّفاتُ مجموعاتِ الدعمِ التي يعملُ فيها البوتُ (ADR-008).
# النوعُ: قائمةٌ بفواصلَ · الإلزامُ: optional · الافتراضيُّ: لا افتراضيَّ · القارئون: 1 · البندُ: M2-04
SUPPORT_GROUP_CHAT_IDS=

# منفذُ استماعِ خدمةِ الدعمِ والتصعيد (ADR-049).
# النوعُ: منفذٌ (1..65535) · الإلزامُ: optional · الافتراضيُّ: 8095 · القارئون: 1 · البندُ: M2-04
SUPPORT_SERVICE_PORT=8095

# عنوانُ الأساسِ لواجهةِ برمجةِ التطبيقاتِ للبوّابةِ الإداريّةِ — يُقرَأُ في api/client.ts عبر import.meta.env.
# النوعُ: عنوانُ HTTP · الإلزامُ: optional · الافتراضيُّ: لا افتراضيَّ · القارئون: 3 · البندُ: M3-04
# ملاحظةٌ: يُمرَّرُ عبرَ سطرِ الأوامرِ في webServer في Playwright، ويُقرَأُ في client.ts عبر import.meta.env.
VITE_API_BASE_URL=

# تفعيل حدّ القناة (ADR-069 · CLM-0524 · M3-09): يبقى معطّلًا افتراضيًا في الإنتاج — لا مسار يُسجَّل حيًّا بلا قرار مالك مستقل (fail-closed).
# النوعُ: نصٌّ · الإلزامُ: optional · الافتراضيُّ: لا افتراضيَّ · القارئون: 2 · البندُ: M3-09
# ملاحظةٌ: الغياب ليس إخفاقًا بل القاعدة: تركيب الحدّ معطّل افتراضيًا ولا يُقرأ إلا بقيمة "true" صريحة.
WASLA_EDGE_ENABLED=

# اسمُ بيئةِ المراقبةِ الذي يختارُ ملفَّ الأهداف infra/observability/targets/<name>.targets لمُجمِّعِ المراقبةِ وPrometheus. إلزاميٌّ لهما ولا قيمةَ افتراضيّة: غيابُهُ أو بيئةٌ مجهولةٌ يُسقِطُ الإقلاعَ (ADR-068).
# النوعُ: نصٌّ · الإلزامُ: conditional · الافتراضيُّ: لا افتراضيَّ · القارئون: 1 · البندُ: M6-18B
WASLA_OBS_ENVIRONMENT=

# مهلةُ إنشاءِ اتّصالٍ بقاعدةِ البياناتِ لكلِّ حوضٍ محروسٍ بالمللي ثانية (الافتراضُ 5000).
# النوعُ: عددٌ صحيحٌ ≥ 1 · الإلزامُ: optional · الافتراضيُّ: لا افتراضيَّ · القارئون: 2 · البندُ: M6-18B
# ملاحظةٌ: يُقرأُ عبرَ `envMs(env, "<الاسم>", …)` في `withPgPoolDefaults` (ADR-059 · RISK-0058 · CLM-0438)، فالبابُ 8 يربطُ حضورَ الاسمِ حرفاً في الملفِّ. الافتراضُ في `PG_GUARD_DEFAULTS`، وقيمةٌ غيرُ صالحةٍ تُرفَضُ.
WASLA_PG_CONNECT_TIMEOUT_MS=

# سقفُ عملاءِ المسبحِ لكلِّ حوضٍ محروسٍ (1..10؛ الافتراضيُّ 2 — RISK-0067). يبقي أسوأَ حالةٍ للأسطولِ 17 × 2 = 34 ≤ 40 خانةَ Supavisor.
# النوعُ: عددٌ صحيحٌ ≥ 1 · الإلزامُ: optional · الافتراضيُّ: 2 · القارئون: 2 · البندُ: M6-18B
# ملاحظةٌ: يُقرأُ عبرَ `envPoolMax` في `withPgPoolDefaults` (RISK-0067 · CLM-0510)، فالبابُ 8 يربطُ حضورَ الاسمِ حرفاً في الملفِّ. الافتراضيُّ في `PG_GUARD_DEFAULTS.poolMax`، وقيمةٌ خارجَ 1..10 تُرفَضُ عندَ الإقلاعِ. `max` صريحٌ من المُنادي (مثل `max: 1` لأدواتِ CLI أحاديةِ اللمسةِ) يغلِبُها.
WASLA_PG_POOL_MAX=2

# مهلةُ الاستعلامِ من جهةِ العميلِ لكلِّ حوضٍ محروسٍ بالمللي ثانية (الافتراضُ 15000).
# النوعُ: عددٌ صحيحٌ ≥ 1 · الإلزامُ: optional · الافتراضيُّ: لا افتراضيَّ · القارئون: 1 · البندُ: M6-18B
# ملاحظةٌ: يُقرأُ عبرَ `envMs(env, "<الاسم>", …)` في `withPgPoolDefaults` (ADR-059 · RISK-0058 · CLM-0438)، فالبابُ 8 يربطُ حضورَ الاسمِ حرفاً في الملفِّ. الافتراضُ في `PG_GUARD_DEFAULTS`، وقيمةٌ غيرُ صالحةٍ تُرفَضُ.
WASLA_PG_QUERY_TIMEOUT_MS=

# شهادةُ CA بصيغةِ PEM لتثبيتِ اتصالِ قاعدةِ البياناتِ عند `WASLA_PG_SSL_MODE=verify-full`. محتوى الشهادةِ لا مسارُ ملفٍّ.
# النوعُ: نصٌّ · الإلزامُ: optional · الافتراضيُّ: لا افتراضيَّ · القارئون: 1 · البندُ: M6-18B
# ملاحظةٌ: يُقرأُ عبرَ `buildSslConfig` في `withPgPoolDefaults` (RISK-0060 · CLM-0453). مطلوبٌ فقط عند `WASLA_PG_SSL_MODE=verify-full`. القيمةُ هي محتوى PEM لا مسارُ ملفٍّ، فالجميعُ يصلُ للقيمةِ ولا يقرأُ من القرصِ.
WASLA_PG_SSL_CA=

# نمطُ TLS لاتّصالاتِ قاعدةِ البيانات: `off` (الافتراضيُّ، لا تشفير)، `require` (TLS بلا التحقّقِ من الشهادة)، أو `verify-full` (TLS مع تثبيتِ شهادةِ CA والتحقّقِ الكامل).
# النوعُ: نصٌّ · الإلزامُ: optional · الافتراضيُّ: off · القارئون: 1 · البندُ: M6-18B
# ملاحظةٌ: يُقرأُ عبرَ `readSslMode` في `withPgPoolDefaults` (RISK-0060 · CLM-0453). `verify-full` يتطلّبُ `WASLA_PG_SSL_CA`. الإنتاجُ يجبُ أن يكونَ `verify-full`. لا يُفعَّلُ في الإنتاجِ إلا بعدَ نشرِ الكودِ على كلِّ خدمةٍ تصلُ إلى قاعدةِ البيانات.
WASLA_PG_SSL_MODE=off

# مُعرِّفُ المفتاحِ النشطِ الذي يُوقَّعُ بهِ الآنَ.
# النوعُ: نصٌّ · الإلزامُ: conditional · الافتراضيُّ: لا افتراضيَّ · القارئون: 7 · البندُ: M2-04
WASLA_SERVICE_AUTH_ACTIVE_KID=

# مادّةُ مفاتيحِ هويّةِ الخدمةِ بصيغةِ `kid:status:secret,…` (M1-04).
# النوعُ: مادّةٌ سرِّيّةٌ · الإلزامُ: conditional · الافتراضيُّ: لا افتراضيَّ · القارئون: 7 · البندُ: M2-04
# ملاحظةٌ: تُقرأُ في `keyRegistryFromEnv` من **قيمةٍ افتراضيّةٍ في دالّةٍ** لا من `process.env.X` — ولذلكَ نمطُها `default_literal` والبابُ 8 يحرسُ رابطَها. ولا تُسجَّلُ في سجلٍّ أبداً.
WASLA_SERVICE_AUTH_KEYS=__SET_ME__

# نمطُ مخزنِ آثارِ رموزِ الخدمةِ: `postgres` (الافتراضُ) أو `memory` بطلبٍ صريحٍ خارجَ الإنتاجِ.
# النوعُ: نصٌّ · الإلزامُ: optional · الافتراضيُّ: postgres · القارئون: 1 · البندُ: M1-03
# ملاحظةٌ: يُقرأُ عبرَ الثابتِ المُصدَّرِ `REPLAY_STORE_MODE_ENV`، فالبابُ 8 يربطُ حضورَ الاسمِ حرفاً في الملفِّ.
WASLA_SERVICE_TOKEN_REPLAY_MODE=postgres

# وصلةُ قاعدةِ مخزنِ آثارِ الرموزِ. غيابُها يعني استعمالَ `DATABASE_URL` نفسِها.
# النوعُ: وصلةُ Postgres · الإلزامُ: conditional · الافتراضيُّ: لا افتراضيَّ · القارئون: 1 · البندُ: M1-03
# ملاحظةٌ: شرطيّةٌ لا دائمةٌ: في نمطِ `postgres` يجبُ أن تُوجَدَ هيَ أو `DATABASE_URL`، وغيابُهُما معاً يُسقِطُ الإقلاعَ بقصدٍ. الصيغةُ: postgresql://USER:PASSWORD@HOST:5432/DB
WASLA_SERVICE_TOKEN_REPLAY_URL=__SET_ME__

# العنوانُ الأساسيُّ لخدمةِ التوزيعِ الذي يُرسِلُ إليه مُجدوِلُ النبضاتِ نبضتَها؛ إلزاميٌّ حينَ تكونُ الخدمةُ ضمنَ WASLA_TICK_SERVICES.
# النوعُ: عنوانُ HTTP · الإلزامُ: conditional · الافتراضيُّ: لا افتراضيَّ · القارئون: 1 · البندُ: M2-09A
WASLA_TICK_BASE_URL_DISPATCH=

# العنوانُ الأساسيُّ لخدمةِ السائقينَ الذي يُرسِلُ إليه مُجدوِلُ النبضاتِ نبضتَها؛ إلزاميٌّ حينَ تكونُ الخدمةُ ضمنَ WASLA_TICK_SERVICES.
# النوعُ: عنوانُ HTTP · الإلزامُ: conditional · الافتراضيُّ: لا افتراضيَّ · القارئون: 1 · البندُ: M2-09A
WASLA_TICK_BASE_URL_DRIVERS=

# العنوانُ الأساسيُّ لخدمةِ المفاوضاتِ الذي يُرسِلُ إليه مُجدوِلُ النبضاتِ نبضتَها؛ إلزاميٌّ حينَ تكونُ الخدمةُ ضمنَ WASLA_TICK_SERVICES.
# النوعُ: عنوانُ HTTP · الإلزامُ: conditional · الافتراضيُّ: لا افتراضيَّ · القارئون: 1 · البندُ: M2-09A
WASLA_TICK_BASE_URL_NEGOTIATIONS=

# العنوانُ الأساسيُّ لخدمةِ السمعةِ الذي يُرسِلُ إليه مُجدوِلُ النبضاتِ نبضتَها؛ إلزاميٌّ حينَ تكونُ الخدمةُ ضمنَ WASLA_TICK_SERVICES.
# النوعُ: عنوانُ HTTP · الإلزامُ: conditional · الافتراضيُّ: لا افتراضيَّ · القارئون: 1 · البندُ: M2-09A
WASLA_TICK_BASE_URL_REPUTATION=

# العنوانُ الأساسيُّ لخدمةِ الاشتراكاتِ الذي يُرسِلُ إليه مُجدوِلُ النبضاتِ نبضتَها؛ إلزاميٌّ حينَ تكونُ الخدمةُ ضمنَ WASLA_TICK_SERVICES.
# النوعُ: عنوانُ HTTP · الإلزامُ: conditional · الافتراضيُّ: لا افتراضيَّ · القارئون: 1 · البندُ: M2-09A
WASLA_TICK_BASE_URL_SUBSCRIPTIONS=

# دليلُ ملفِّ قفلِ التداخلِ لمُجدوِلِ النبضاتِ (يمنعُ التداخلَ داخلَ حاويةٍ واحدةٍ فقط).
# النوعُ: نصٌّ · الإلزامُ: optional · الافتراضيُّ: /tmp · القارئون: 1 · البندُ: M2-09A
WASLA_TICK_LOCK_DIR=/tmp

# قائمةُ الخدماتِ التي تُشغَّلُ نبضتُها في هذا التشغيلِ مفصولةً بفواصلَ؛ الغيابُ يعني الخمسَ كلَّها، والاسمُ المجهولُ خطأُ تهيئةٍ.
# النوعُ: نصٌّ · الإلزامُ: optional · الافتراضيُّ: لا افتراضيَّ · القارئون: 1 · البندُ: M2-09A
WASLA_TICK_SERVICES=

# مهلةُ نداءِ النبضةِ الواحدِ بالمللي ثانية — قيمةٌ غيرُ صالحةٍ خطأُ تهيئةٍ (خروجٌ 2) لا سقوطٌ إلى الافتراضِ.
# النوعُ: عددٌ صحيحٌ ≥ 1 · الإلزامُ: optional · الافتراضيُّ: 30000 · القارئون: 1 · البندُ: M2-09A
WASLA_TICK_TIMEOUT_MS=30000

# وضعُ تحقُّقِ الخدمةِ المُستقبِلةِ من تأكيدِ المستخدمِ النهائيِّ wua1: `off` | `observe` | `enforce` (ADR-060 · CLM-0440). الافتراضيُّ `off`؛ ولا يُضبطُ `observe`/`enforce` على Render إلّا بقرارِ مالكٍ مكتوبٍ (P3).
# النوعُ: نصٌّ · الإلزامُ: optional · الافتراضيُّ: off · القارئون: 1 · البندُ: M0-49
WASLA_USER_ASSERTION_MODE=off

# المفاتيحُ العامّةُ Ed25519 للتحقُّقِ من wua1: JSON `{kid: base64 SPKI}` (ADR-060 · CLM-0440). تحملُها الخدماتُ المُستقبِلةُ وحدَها.
# النوعُ: مادّةٌ سرِّيّةٌ · الإلزامُ: optional · الافتراضيُّ: لا افتراضيَّ · القارئون: 1 · البندُ: M0-49
# ملاحظةٌ: مادّةٌ عامّةٌ لا سرٌّ، وتُصنَّفُ `secret_material` لأنَّ اللاحقةَ `_KEYS` تفرضُهُ (حارسُ الأنواعِ) — والتصنيفُ الأحوطُ لا يضرُّ: نائبٌ في المثالِ ولا تسجيلَ. دورةُ الحياةِ: docs/07-security/USER_ASSERTION_KEY_LIFECYCLE.md.
WASLA_USER_ASSERTION_PUBLIC_KEYS=__SET_ME__

# مفتاحُ Ed25519 الخاصُّ لإصدارِ wua1 بصيغةِ `<kid>:<base64 PKCS#8>` — في `identity` وحدَها (ADR-060 · CLM-0440). غيابُهُ ⇒ `POST /identity/assertions` يُجيبُ 503.
# النوعُ: مادّةٌ سرِّيّةٌ · الإلزامُ: optional · الافتراضيُّ: لا افتراضيَّ · القارئون: 1 · البندُ: M0-49
# ملاحظةٌ: لا يُلتزَمُ في Git ولا يُطبَعُ ولا يُسجَّلُ؛ يُولَّدُ محلّيّاً ويُخزَّنُ سرّاً على خدمةِ identity وحدَها عندَ P3. دورةُ الحياةِ: docs/07-security/USER_ASSERTION_KEY_LIFECYCLE.md.
WASLA_USER_ASSERTION_SIGNING_KEY=__SET_ME__

# ────────────────────────────────────────────────────────────────────
# متغيّراتُ الأدواتِ (ترحيلاتٌ وسكربتاتُ تشغيلٍ) (1 متغيّراً)
# ────────────────────────────────────────────────────────────────────

# وصلةُ Postgres للخدمةِ الجاريةِ — كلُّ خدمةٍ تقرأُ الاسمَ نفسَهُ في نشرتِها.
# النوعُ: وصلةُ Postgres · الإلزامُ: conditional · الافتراضيُّ: لا افتراضيَّ · القارئون: 101 · البندُ: M2-04
# ملاحظةٌ: غيابُها ليسَ إخفاقاً بقصدٍ: الخدمةُ تُقلِعُ بمخازنِ الذاكرةِ وتُعلِنُ `persistence: memory` في صحّتِها. الصيغةُ: postgresql://USER:PASSWORD@HOST:5432/DB
DATABASE_URL=__SET_ME__

# ────────────────────────────────────────────────────────────────────
# متغيّراتُ الاختبارِ والتكاملِ المحليِّ (19 متغيّراً)
# ────────────────────────────────────────────────────────────────────

# علامةُ بيئةِ التكاملِ المستمرِّ — تُستعملُ في Playwright لتمييزِ بيئةِ CI عن المحليِّ.
# النوعُ: نصٌّ · الإلزامُ: optional · الافتراضيُّ: لا افتراضيَّ · القارئون: 3 · البندُ: M3-01
# ملاحظةٌ: متغيّرٌ قياسيٌّ تُضبطُهُ منصّاتُ CI تلقائيّاً. لا يُقرأُ في الشيفرةِ الإنتاجيّةِ — يُستعملُ في إعداداتِ Playwright فقط.
CI=

# وصلةُ Postgres لجداولِ بوتِ العميلِ وحزمةِ تكاملِهِ.
# النوعُ: وصلةُ Postgres · الإلزامُ: conditional · الافتراضيُّ: لا افتراضيَّ · القارئون: 2 · البندُ: M2-04
CUSTOMER_DATABASE_URL=__SET_ME__

# وصلةُ Postgres للخدمةِ الجاريةِ — كلُّ خدمةٍ تقرأُ الاسمَ نفسَهُ في نشرتِها.
# النوعُ: وصلةُ Postgres · الإلزامُ: conditional · الافتراضيُّ: لا افتراضيَّ · القارئون: 101 · البندُ: M2-04
# ملاحظةٌ: غيابُها ليسَ إخفاقاً بقصدٍ: الخدمةُ تُقلِعُ بمخازنِ الذاكرةِ وتُعلِنُ `persistence: memory` في صحّتِها. الصيغةُ: postgresql://USER:PASSWORD@HOST:5432/DB
DATABASE_URL=__SET_ME__

# وصلةُ Postgres لحزمةِ تكاملِ الإرسالِ (اختبارٌ فقط).
# النوعُ: وصلةُ Postgres · الإلزامُ: conditional · الافتراضيُّ: لا افتراضيَّ · القارئون: 1 · البندُ: M2-04
DISPATCH_DATABASE_URL=__SET_ME__

# وصلةُ Postgres لجداولِ بوتِ الكابتنِ وحزمةِ تكاملِهِ.
# النوعُ: وصلةُ Postgres · الإلزامُ: conditional · الافتراضيُّ: لا افتراضيَّ · القارئون: 2 · البندُ: M2-04
DRIVER_DATABASE_URL=__SET_ME__

# يُحوِّلُ تخطّيَ بوّابةِ الخروجِ عندَ غيابِ قاعدةِ البياناتِ إلى إخفاقٍ باسمِهِ.
# النوعُ: رايةٌ (1 يُفعِّلُ) · الإلزامُ: optional · الافتراضيُّ: لا افتراضيَّ · القارئون: 2 · البندُ: M2-04
# ملاحظةٌ: قيمتُهُ الفاعلةُ `1` حرفاً — أيُّ قيمةٍ أخرى تُقرأُ «غيرَ مضبوطٍ».
EXIT_GATE_REQUIRE_DB=

# مفتاحُ مصادقةِ الخدمةِ لاختباراتِ الرحلاتِ الذهبيّةِ.
# النوعُ: نصٌّ · الإلزامُ: optional · الافتراضيُّ: لا افتراضيَّ · القارئون: 2 · البندُ: M4-02
GOLDEN_SERVICE_AUTH_KEY=__SET_ME__

# معرِّفُ مفتاحِ مصادقةِ الخدمةِ لاختباراتِ الرحلاتِ الذهبيّةِ.
# النوعُ: نصٌّ · الإلزامُ: optional · الافتراضيُّ: لا افتراضيَّ · القارئون: 2 · البندُ: M4-02
GOLDEN_SERVICE_AUTH_KID=

# تُفعّلُ اختباراتِ الرحلاتِ الذهبيّةِ ضدَّ staging (أيُّ قيمةٍ غيرِ فارغةٍ).
# النوعُ: نصٌّ · الإلزامُ: optional · الافتراضيُّ: لا افتراضيَّ · القارئون: 3 · البندُ: M4-02
GOLDEN_STAGING_BASE=

# وصلةُ Postgres لحزمةِ تكاملِ المفاوضاتِ (اختبارٌ فقط).
# النوعُ: وصلةُ Postgres · الإلزامُ: conditional · الافتراضيُّ: لا افتراضيَّ · القارئون: 1 · البندُ: M2-04
NEGOTIATION_DATABASE_URL=__SET_ME__

# وصلةُ Postgres لحزمةِ تكاملِ الطلباتِ (اختبارٌ فقط).
# النوعُ: وصلةُ Postgres · الإلزامُ: conditional · الافتراضيُّ: لا افتراضيَّ · القارئون: 1 · البندُ: M2-04
ORDER_DATABASE_URL=__SET_ME__

# عنوانُ الأساسِ لواجهةِ برمجةِ التطبيقاتِ للبوّابةِ الإداريّةِ — يُقرَأُ في api/client.ts عبر import.meta.env.
# النوعُ: عنوانُ HTTP · الإلزامُ: optional · الافتراضيُّ: لا افتراضيَّ · القارئون: 3 · البندُ: M3-04
# ملاحظةٌ: يُمرَّرُ عبرَ سطرِ الأوامرِ في webServer في Playwright، ويُقرَأُ في client.ts عبر import.meta.env.
VITE_API_BASE_URL=

# علّامةُ بيئةِ اختبارِ E2E — تُفعِّلُ hook جلسةِ الاختبارِ في main.tsx (tree-shaken في الإنتاج).
# النوعُ: نصٌّ · الإلزامُ: optional · الافتراضيُّ: لا افتراضيَّ · القارئون: 4 · البندُ: M3-01
# ملاحظةٌ: تُمرَّرُ عبرَ سطرِ الأوامرِ في webServer في Playwright، ويُقرأُها main.tsx عبرَ import.meta.env. تُزالُ بالكاملِ من حزمةِ الإنتاجِ عندَ غيابِها.
VITE_E2E=

# مهلةُ إنشاءِ اتّصالٍ بقاعدةِ البياناتِ لكلِّ حوضٍ محروسٍ بالمللي ثانية (الافتراضُ 5000).
# النوعُ: عددٌ صحيحٌ ≥ 1 · الإلزامُ: optional · الافتراضيُّ: لا افتراضيَّ · القارئون: 2 · البندُ: M6-18B
# ملاحظةٌ: يُقرأُ عبرَ `envMs(env, "<الاسم>", …)` في `withPgPoolDefaults` (ADR-059 · RISK-0058 · CLM-0438)، فالبابُ 8 يربطُ حضورَ الاسمِ حرفاً في الملفِّ. الافتراضُ في `PG_GUARD_DEFAULTS`، وقيمةٌ غيرُ صالحةٍ تُرفَضُ.
WASLA_PG_CONNECT_TIMEOUT_MS=

# سقفُ عملاءِ المسبحِ لكلِّ حوضٍ محروسٍ (1..10؛ الافتراضيُّ 2 — RISK-0067). يبقي أسوأَ حالةٍ للأسطولِ 17 × 2 = 34 ≤ 40 خانةَ Supavisor.
# النوعُ: عددٌ صحيحٌ ≥ 1 · الإلزامُ: optional · الافتراضيُّ: 2 · القارئون: 2 · البندُ: M6-18B
# ملاحظةٌ: يُقرأُ عبرَ `envPoolMax` في `withPgPoolDefaults` (RISK-0067 · CLM-0510)، فالبابُ 8 يربطُ حضورَ الاسمِ حرفاً في الملفِّ. الافتراضيُّ في `PG_GUARD_DEFAULTS.poolMax`، وقيمةٌ خارجَ 1..10 تُرفَضُ عندَ الإقلاعِ. `max` صريحٌ من المُنادي (مثل `max: 1` لأدواتِ CLI أحاديةِ اللمسةِ) يغلِبُها.
WASLA_PG_POOL_MAX=2

# مهلةُ الاستعلامِ من جهةِ العميلِ لكلِّ حوضٍ محروسٍ بالمللي ثانية (الافتراضُ 15000).
# النوعُ: عددٌ صحيحٌ ≥ 1 · الإلزامُ: optional · الافتراضيُّ: لا افتراضيَّ · القارئون: 1 · البندُ: M6-18B
# ملاحظةٌ: يُقرأُ عبرَ `envMs(env, "<الاسم>", …)` في `withPgPoolDefaults` (ADR-059 · RISK-0058 · CLM-0438)، فالبابُ 8 يربطُ حضورَ الاسمِ حرفاً في الملفِّ. الافتراضُ في `PG_GUARD_DEFAULTS`، وقيمةٌ غيرُ صالحةٍ تُرفَضُ.
WASLA_PG_QUERY_TIMEOUT_MS=

# نمطُ TLS لاتّصالاتِ قاعدةِ البيانات: `off` (الافتراضيُّ، لا تشفير)، `require` (TLS بلا التحقّقِ من الشهادة)، أو `verify-full` (TLS مع تثبيتِ شهادةِ CA والتحقّقِ الكامل).
# النوعُ: نصٌّ · الإلزامُ: optional · الافتراضيُّ: off · القارئون: 1 · البندُ: M6-18B
# ملاحظةٌ: يُقرأُ عبرَ `readSslMode` في `withPgPoolDefaults` (RISK-0060 · CLM-0453). `verify-full` يتطلّبُ `WASLA_PG_SSL_CA`. الإنتاجُ يجبُ أن يكونَ `verify-full`. لا يُفعَّلُ في الإنتاجِ إلا بعدَ نشرِ الكودِ على كلِّ خدمةٍ تصلُ إلى قاعدةِ البيانات.
WASLA_PG_SSL_MODE=off

# نمطُ مخزنِ آثارِ رموزِ الخدمةِ: `postgres` (الافتراضُ) أو `memory` بطلبٍ صريحٍ خارجَ الإنتاجِ.
# النوعُ: نصٌّ · الإلزامُ: optional · الافتراضيُّ: postgres · القارئون: 1 · البندُ: M1-03
# ملاحظةٌ: يُقرأُ عبرَ الثابتِ المُصدَّرِ `REPLAY_STORE_MODE_ENV`، فالبابُ 8 يربطُ حضورَ الاسمِ حرفاً في الملفِّ.
WASLA_SERVICE_TOKEN_REPLAY_MODE=postgres

# وصلةُ قاعدةِ مخزنِ آثارِ الرموزِ. غيابُها يعني استعمالَ `DATABASE_URL` نفسِها.
# النوعُ: وصلةُ Postgres · الإلزامُ: conditional · الافتراضيُّ: لا افتراضيَّ · القارئون: 1 · البندُ: M1-03
# ملاحظةٌ: شرطيّةٌ لا دائمةٌ: في نمطِ `postgres` يجبُ أن تُوجَدَ هيَ أو `DATABASE_URL`، وغيابُهُما معاً يُسقِطُ الإقلاعَ بقصدٍ. الصيغةُ: postgresql://USER:PASSWORD@HOST:5432/DB
WASLA_SERVICE_TOKEN_REPLAY_URL=__SET_ME__
