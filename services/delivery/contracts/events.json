                        "string",
                        "null"
                      ]
                    }
                  }
                }
              }
            }
          }
        }
      ]
    },
    "StoreOrderItemSubstitutedV1": {
      "allOf": [
        {
          "$ref": "#/$defs/EventEnvelope"
        },
        {
          "type": "object",
          "required": [
            "event_type",
            "payload"
          ],
          "properties": {
            "event_type": {
              "const": "store_order.item_substituted"
            },
            "event_version": {
              "const": "v1"
            },
            "aggregate": {
              "type": "object",
              "required": [
                "type",
                "id"
              ],
              "properties": {
                "type": {
                  "const": "store_order"
                },
                "id": {
                  "type": "string",
                  "format": "uuid"
                }
              }
            },
            "payload": {
              "type": "object",
              "required": [
                "public_id",
                "line_no",
                "original_product_id",
                "substituted_product_id",
                "quantity",
                "reason_code",
                "price_delta_minor_units",
                "actor"
              ],
              "properties": {
                "public_id": {
                  "$ref": "#/$defs/WaslaPublicId"
                },
                "line_no": {
                  "type": "integer",
                  "minimum": 1
                },
                "original_product_id": {
                  "type": "string",
                  "format": "uuid"
                },
                "substituted_product_id": {
                  "type": "string",
                  "format": "uuid"
                },
                "quantity": {
                  "type": "integer",
                  "minimum": 1
                },
                "reason_code": {
                  "$ref": "#/$defs/SubstitutionReasonCode"
                },
                "price_delta_minor_units": {
                  "type": "integer",
                  "description": "فرقُ السعرِ محسوبٌ لا مُخمَّنٌ: سعرُ البديلِ ناقصَ لقطةِ الأصليِّ — قد يكونُ سالباً (ADR-026 §2.5)."
                },
                "actor": {
                  "type": "object",
                  "required": [
