                },
                "to_state": {
                  "const": "consumed"
                },
                "reason_code": {
                  "const": "INVENTORY_CONSUMED"
                },
                "reservation_ref": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128
                },
                "actor": {
                  "type": "object",
                  "required": [
                    "actor_type"
                  ],
                  "properties": {
                    "actor_type": {
                      "$ref": "#/$defs/ActorType"
                    },
                    "actor_ref": {
