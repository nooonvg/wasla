{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wasla.local/delivery/events/v1",
  "title": "WASLA Store Orders & Delivery Domain Events v1",
  "description": "أحداث خدمة التوصيل (Phase 13 — طلباتُ المتجرِ والتوصيلُ). القاعدة الحاكمة (ADR-026): الحدث أثرُ قرارٍ دخل دفتراً — لا إعلانَ نيّةٍ ولا نتيجةَ مؤقّت. كلُّ حمولةِ قرارٍ تحمل حالتَها السابقةَ واللاحقةَ وسببَها المغلقَ وفاعلَها. وكلُّ حدثٍ يُكتبُ في المعاملةِ نفسِها عبرَ delivery_outbox فلا تغييرَ صامت. قواعدُ الخصوصيّةِ (ADR-026 §2.6 · ADR-001 · ADR-007): لا اسمَ ولا هاتفَ ولا بريدَ ولا إحداثيّاتَ ولا مُعرّفَ قناة — المالكُ والمندوبُ مراجعُ opaque بصيغة WS-##########، والحالةُ الحيّةُ انتقالُ حالةٍ لا موقعٌ. والمالُ (إذا وُجدَ) لقطةُ طلبٍ بأصغرِ وحدةٍ وعملةِ SAR وحدها — لا معاملةَ ولا تحصيلَ (الدفعُ مرآةُ مرجعٍ خارجيٍّ · الفوترةُ M5-17). والاستبدالُ قرارُ صنفٍ لا طلبٍ (ADR-026 §2.5). والتوصيلُ مرآةٌ خشنةٌ لنتائجِ dispatch — لا منطقَ عروضٍ ولا موجاتٍ هنا (ADR-026 §2.4).",
  "$defs": {
    "EventEnvelope": {
      "type": "object",
      "description": "مغلّف موحّد لكل أحداث وصلة. لا حدث بلا مغلّف.",
      "required": [
        "event_id",
        "event_type",
        "event_version",
        "occurred_at",
        "producer",
        "aggregate"
      ],
      "properties": {
        "event_id": {
          "type": "string",
          "format": "uuid"
        },
        "event_type": {
          "type": "string",
          "minLength": 3
        },
        "event_version": {
          "type": "string",
          "pattern": "^v[0-9]+$"
        },
        "occurred_at": {
          "type": "string",
          "format": "date-time"
        },
        "producer": {
          "const": "delivery-service"
        },
        "aggregate": {
          "type": "object",
          "required": [
            "type",
            "id"
          ],
          "properties": {
            "type": {
              "type": "string",
              "enum": [
                "store_order",
                "delivery_task"
              ]
            },
            "id": {
              "type": "string"
            }
          }
        },
        "trace_id": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "WaslaPublicId": {
      "type": "string",
      "pattern": "^WS-[0-9]{10}$"
    },
    "StoreSlug": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{2,47}$",
      "description": "مرجعُ المتجرِ العامُّ كما ينشرُهُ السوقُ — لا صيغةَ WS- (المراجعةُ 8/N · ADR-026 §4.11)"
    },
    "ActorType": {
      "type": "string",
      "enum": [
        "system",
        "customer",
        "store",
        "courier",
        "admin",
        "dispatch"
      ]
    },
    "FulfillmentState": {
      "type": "string",
      "enum": [
        "draft",
        "placed",
        "confirmed",
        "picking",
        "picked",
        "ready_for_delivery",
        "assigned",
        "handed_to_courier",
        "delivered",
        "cancelled",
        "rejected",
        "failed"
      ]
    },
    "PaymentState": {
      "type": "string",
      "enum": [
        "pending",
        "authorized",
        "captured",
        "failed",
        "refunding",
        "partially_refunded",
        "refunded"
      ]
    },
    "DeliveryTaskState": {
      "type": "string",
      "enum": [
        "pending_eligibility",
        "eligible",
        "dispatch_requested",
        "driver_assigned",
        "timed_out",
        "reassigned",
        "exhausted",
        "picked_up",
        "in_transit",
        "arrived",
        "delivered",
        "ineligible",
        "failed",
        "cancelled"
      ]
    },
    "StoreOrderCancelReasonCode": {
      "type": "string",
      "enum": [
        "CUSTOMER_CHANGED_MIND",
        "CUSTOMER_UNAVAILABLE",
        "PAYMENT_FAILED",
        "STORE_REQUESTED",
        "SYSTEM_MAINTENANCE",
        "DELIVERY_NOT_FEASIBLE"
      ],
      "description": "قائمةٌ مغلقة. سببٌ حرٌّ كان سيجعل «لماذا أُلغيَ الطلبُ؟» سؤالاً يُجابُ بالقراءةِ لا بالعدّ."
    },
    "StoreOrderRejectReasonCode": {
      "type": "string",
      "enum": [
        "OUT_OF_STOCK",
        "STORE_CLOSED",
        "ITEM_UNAVAILABLE",
        "PRICE_MISMATCH",
        "POLICY_VIOLATION"
      ]
    },
    "FulfillmentReasonCode": {
      "type": "string",
      "enum": [
        "CART_CONFIRMED",
        "PAYMENT_AUTHORIZED",
        "PICKING_STARTED",
        "PICKING_COMPLETED",
        "READY_FOR_HANDOVER",
        "MOVE_JOB_ACCEPTED",
        "COURIER_ACCEPTED",
        "CORE_FULFILLMENT_CANCELLED",
        "DELIVERED_WITH_PROOF",
        "DELIVERY_ATTEMPTS_EXHAUSTED",
        "SUBSTITUTION_APPLIED"
      ]
    },
    "PaymentReasonCode": {
      "type": "string",
      "enum": [
        "AUTHORIZATION_SUCCEEDED",
        "CAPTURE_SUCCEEDED",
        "AUTHORIZATION_FAILED",
        "REFUND_INITIATED",
        "REFUND_COMPLETED",
        "PARTIAL_REFUND_COMPLETED"
      ]
    },
    "SubstitutionReasonCode": {
      "type": "string",
      "enum": [
        "out_of_stock",
        "customer_approved_alternative",
        "store_policy"
      ]
    },
    "IneligibilityReasonCode": {
      "type": "string",
      "enum": [
        "outside_coverage",
        "store_not_orderable",
        "no_courier_service"
      ]
    },
    "DeliveryFailReasonCode": {
      "type": "string",
      "enum": [
        "CUSTOMER_UNREACHABLE",
        "ADDRESS_NOT_FOUND",
        "ORDER_DAMAGED",
        "COURIER_ABORTED",
        "ATTEMPTS_EXHAUSTED"
      ]
    },
    "ProofType": {
      "type": "string",
      "enum": [
        "otp",
        "photo",
        "signature",
        "pin_code"
      ]
    },
    "OrderTotals": {
      "type": "object",
      "description": "لقطةُ مالِ الطلبِ وقتَ الإنشاءِ — أصغرُ وحدةٍ (هللة) وعملةٌ واحدةٌ (SAR). لا يُقرأُ سعرُ الكتالوجِ بعدَ الطلبِ (ADR-026 §2.6).",
      "required": [
        "currency_code",
        "items_total_minor_units",
        "delivery_fee_minor_units",
        "total_minor_units"
      ],
      "properties": {
        "currency_code": {
          "const": "SAR"
        },
        "items_total_minor_units": {
          "type": "integer",
          "minimum": 0
        },
        "delivery_fee_minor_units": {
          "type": "integer",
          "minimum": 0
        },
        "total_minor_units": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "OrderLineSnapshot": {
      "type": "object",
      "required": [
        "line_no",
        "product_id",
        "sku",
        "quantity",
        "unit_price_minor_units",
        "line_total_minor_units"
      ],
      "properties": {
        "line_no": {
          "type": "integer",
          "minimum": 1
        },
        "product_id": {
          "type": "string",
          "format": "uuid"
        },
        "sku": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "quantity": {
          "type": "integer",
          "minimum": 1
        },
        "unit_price_minor_units": {
          "type": "integer",
          "minimum": 0
        },
        "line_total_minor_units": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "StoreOrderCreatedV1": {
      "allOf": [
        {
          "$ref": "#/$defs/EventEnvelope"
        },
        {
          "type": "object",
          "required": [
            "event_type",
            "payload"
          ],
          "properties": {
            "event_type": {
              "const": "store_order.created"
            },
            "event_version": {
              "const": "v1"
            },
            "aggregate": {
              "type": "object",
              "required": [
                "type",
                "id"
              ],
              "properties": {
                "type": {
                  "const": "store_order"
                },
                "id": {
                  "type": "string",
                  "format": "uuid"
                }
              }
            },
            "payload": {
              "type": "object",
              "required": [
                "public_id",
                "customer_ref",
                "store_id",
                "store_slug",
                "from_state",
                "to_state",
                "items",
                "totals",
                "actor"
              ],
              "properties": {
                "public_id": {
                  "$ref": "#/$defs/WaslaPublicId"
                },
                "customer_ref": {
                  "$ref": "#/$defs/WaslaPublicId"
                },
                "store_id": {
                  "type": "string",
                  "format": "uuid"
                },
                "store_slug": {
                  "$ref": "#/$defs/StoreSlug"
                },
                "from_state": {
                  "$ref": "#/$defs/FulfillmentState"
                },
                "to_state": {
                  "$ref": "#/$defs/FulfillmentState"
                },
                "items": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "$ref": "#/$defs/OrderLineSnapshot"
                  }
                },
                "totals": {
                  "$ref": "#/$defs/OrderTotals"
                },
                "actor": {
                  "type": "object",
                  "required": [
                    "actor_type"
                  ],
                  "properties": {
                    "actor_type": {
                      "$ref": "#/$defs/ActorType"
                    },
                    "actor_ref": {
                      "type": [
                        "string",
                        "null"
                      ]
                    }
                  }
                }
              }
            }
          }
        }
      ]
    },
    "StoreOrderFulfillmentStateChangedV1": {
      "allOf": [
        {
          "$ref": "#/$defs/EventEnvelope"
        },
        {
          "type": "object",
          "required": [
            "event_type",
            "payload"
          ],
          "properties": {
            "event_type": {
              "const": "store_order.fulfillment_state_changed"
            },
            "event_version": {
              "const": "v1"
            },
            "aggregate": {
              "type": "object",
              "required": [
                "type",
                "id"
              ],
              "properties": {
                "type": {
                  "const": "store_order"
                },
                "id": {
                  "type": "string",
                  "format": "uuid"
                }
              }
            },
            "payload": {
              "type": "object",
              "required": [
                "public_id",
                "from_state",
                "to_state",
                "reason_code",
                "actor"
              ],
              "properties": {
                "public_id": {
                  "$ref": "#/$defs/WaslaPublicId"
                },
                "from_state": {
                  "$ref": "#/$defs/FulfillmentState"
                },
                "to_state": {
                  "$ref": "#/$defs/FulfillmentState"
                },
                "reason_code": {
                  "anyOf": [
                    {
                      "$ref": "#/$defs/FulfillmentReasonCode"
                    },
                    {
                      "$ref": "#/$defs/StoreOrderCancelReasonCode"
                    },
                    {
                      "$ref": "#/$defs/StoreOrderRejectReasonCode"
                    }
                  ]
                },
                "payment_state": {
                  "$ref": "#/$defs/PaymentState"
                },
                "proof": {
                  "type": [
                    "object",
                    "null"
                  ],
                  "required": [
                    "proof_type",
                    "proof_ref"
                  ],
                  "properties": {
                    "proof_type": {
                      "$ref": "#/$defs/ProofType"
                    },
                    "proof_ref": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 256
                    }
                  }
                },
                "actor": {
                  "type": "object",
                  "required": [
                    "actor_type"
                  ],
                  "properties": {
                    "actor_type": {
                      "$ref": "#/$defs/ActorType"
                    },
                    "actor_ref": {
                      "type": [
                        "string",
                        "null"
                      ]
                    }
                  }
                }
              }
            }
          }
        }
      ]
    },
    "StoreOrderPaymentStateChangedV1": {
      "allOf": [
        {
          "$ref": "#/$defs/EventEnvelope"
        },
        {
          "type": "object",
          "required": [
            "event_type",
            "payload"
          ],
          "properties": {
            "event_type": {
              "const": "store_order.payment_state_changed"
            },
            "event_version": {
              "const": "v1"
            },
            "aggregate": {
              "type": "object",
              "required": [
                "type",
                "id"
              ],
              "properties": {
                "type": {
                  "const": "store_order"
                },
                "id": {
                  "type": "string",
                  "format": "uuid"
                }
              }
            },
            "payload": {
              "type": "object",
              "required": [
                "public_id",
                "from_state",
                "to_state",
                "reason_code",
                "actor"
              ],
              "properties": {
                "public_id": {
                  "$ref": "#/$defs/WaslaPublicId"
                },
                "from_state": {
                  "$ref": "#/$defs/PaymentState"
                },
                "to_state": {
                  "$ref": "#/$defs/PaymentState"
                },
                "reason_code": {
                  "$ref": "#/$defs/PaymentReasonCode"
                },
                "payment_ref": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "minLength": 1,
                  "maxLength": 128
                },
                "actor": {
                  "type": "object",
                  "required": [
                    "actor_type"
                  ],
                  "properties": {
                    "actor_type": {
                      "$ref": "#/$defs/ActorType"
                    },
                    "actor_ref": {
                      "type": [
                        "string",
                        "null"
                      ]
                    }
                  }
                }
              }
            }
          }
        }
      ]
    },
    "InventoryState": {
      "type": "string",
      "enum": ["none", "reserving", "reserved", "released", "consumed"],
      "description": "حالةُ المخزونِ على الطلبِ (المراجعةُ 10/N · ADR-026 §2.3)."
    },
    "InventoryReasonCode": {
      "type": "string",
      "enum": ["INVENTORY_RESERVED", "INVENTORY_INSUFFICIENT", "INVENTORY_RELEASED", "INVENTORY_CONSUMED"],
      "description": "سبَبُ انتقالِ حالةِ المخزون."
    },
    "StoreOrderInventoryReservedV1": {
      "allOf": [
        {
          "$ref": "#/$defs/EventEnvelope"
        },
        {
          "type": "object",
          "required": [
            "event_type",
            "payload"
          ],
          "properties": {
            "event_type": {
              "const": "store_order.inventory_reserved"
            },
            "event_version": {
              "const": "v1"
            },
            "aggregate": {
              "type": "object",
              "required": [
                "type",
                "id"
              ],
              "properties": {
                "type": {
                  "const": "store_order"
                },
                "id": {
                  "type": "string",
                  "format": "uuid"
                }
              }
            },
            "payload": {
              "type": "object",
              "required": [
                "public_id",
                "from_state",
                "to_state",
                "reason_code",
                "reservation_ref",
                "actor"
              ],
              "properties": {
                "public_id": {
                  "$ref": "#/$defs/WaslaPublicId"
                },
                "from_state": {
                  "$ref": "#/$defs/InventoryState"
                },
                "to_state": {
                  "$ref": "#/$defs/InventoryState"
                },
                "reason_code": {
                  "$ref": "#/$defs/InventoryReasonCode"
                },
                "reservation_ref": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128
                },
                "actor": {
                  "type": "object",
                  "required": [
                    "actor_type"
                  ],
                  "properties": {
                    "actor_type": {
                      "$ref": "#/$defs/ActorType"
                    },
                    "actor_ref": {
                      "type": [
                        "string",
                        "null"
                      ]
                    }
                  }
                }
              }
            }
          }
        }
      ]
    },
    "StoreOrderInventoryReleasedV1": {
      "allOf": [
        {
          "$ref": "#/$defs/EventEnvelope"
        },
        {
          "type": "object",
          "required": [
            "event_type",
            "payload"
          ],
          "properties": {
            "event_type": {
              "const": "store_order.inventory_released"
            },
