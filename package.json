{
  "name": "wasla",
  "version": "0.0.0",
  "private": true,
  "description": "WASLA — منصة لوجستية وتشغيلية (Monorepo). أنظر README.md و docs/.",
  "license": "UNLICENSED",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "build": "pnpm -r run build",
    "typecheck": "pnpm -r run typecheck",
    "test": "bash scripts/run-tests.sh",
    "verify": "bash scripts/verify.sh",
    "clean": "pnpm -r run clean && rimraf node_modules",
    "governance:verify": "bash scripts/checks/verify-governance.sh",
    "governance:test": "bash scripts/checks/test-governance.sh",
    "state:verify": "bash scripts/checks/validate-state-sync.sh",
    "state:current": "bash scripts/state/current-state.sh",
    "work:find": "bash scripts/checks/find-existing-work.sh",
    "work:claims": "bash scripts/checks/validate-work-claims.sh",
    "board:validate": "bash scripts/checks/validate-launch-board.sh"
  },
  "devDependencies": {
    "json-schema-to-typescript": "^15.0.4",
    "openapi-typescript": "^7.13.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  },
  "pnpm": {
    "overrides": {
      "vitest": "3.2.7",
      "vite": "^6.4.4",
      "esbuild": "^0.25.12",
      "fast-uri@3": "^3.1.8",
      "fast-uri@4": "~4.1.5",
      "js-yaml@4": "^4.3.2",
      "brace-expansion@2": "^2.1.7",
      "source-map-js": "^1.2.2",
      "tinypool": "^2.1.2"
    }
  }
}
